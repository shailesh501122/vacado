# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (Postgres)
DATABASE_URL=postgres://vacado:vacado@localhost:5432/vacado
PGSSL=false

# Redis (optional — gracefully degrades if unavailable)
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
# Set to false in production — returns OTP code in API response in dev only
OTP_DEV_BYPASS=true

# CORS — restrict to your actual domains in production
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Admin seed credentials (used by seedAdmin.js / seedStaff.js)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Vacado Admin
ADMIN_EMAIL=admin@vacado.app
