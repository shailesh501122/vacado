# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (Postgres)
DATABASE_URL=postgres://vacado:vacado@localhost:5432/vacado
PGSSL=false

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_DEV_BYPASS=true

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
